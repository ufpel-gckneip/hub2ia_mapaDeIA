# Copy to .env and edit. Never commit .env.

# ── Postgres ──
POSTGRES_USER=mapadeia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mapadeia

# ── Backend ──
# REQUIRED. The API refuses to start unless this is a strong, non-placeholder
# value (>= 32 chars). Generate one with:  openssl rand -hex 32
SECRET_KEY=
WEB_CONCURRENCY=2

# ── Frontend / edge ──
# Domain for automatic HTTPS (e.g. mapadeia.inf.ufpel.edu.br), or ":80" for local HTTP.
SITE_ADDRESS=:80
# Allowed CORS origins for the API (comma-separated). Match your SITE_ADDRESS host.
CORS_ORIGINS=http://localhost
