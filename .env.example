# Copy to .env and edit. Never commit .env.

# ── Postgres ──
POSTGRES_USER=mapadeia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mapadeia

# ── Backend ──
# REQUIRED. The API refuses to start unless this is a strong, non-placeholder
# value (>= 32 chars). Generate one with:  openssl rand -hex 32
SECRET_KEY=
# Number of gunicorn workers. Keep at 1: the API cache is in-process
# (backend/app/cache.py), so >1 worker means each has its own cache and
# pipeline invalidation only reaches one. Raise only with a shared cache (Redis).
WEB_CONCURRENCY=1

# ── Frontend / edge ──
# Domain for automatic HTTPS (e.g. mapadeia.inf.ufpel.edu.br), or ":80" for local HTTP.
SITE_ADDRESS=:80
# Allowed CORS origins for the API (comma-separated). Match your SITE_ADDRESS host.
CORS_ORIGINS=http://localhost
